:root {
  --navy: #172554;
  --blue: #2563eb;
  --purple: #7c3aed;
  --pink: #db2777;
  --orange: #ea580c;
  --yellow: #facc15;
  --green: #059669;
  --red: #dc2626;
  --red-dark: #991b1b;
  --cyan: #0891b2;
  --cream: #fff7ed;
  --light-blue: #eff6ff;
  --light-purple: #f5f3ff;
  --light-pink: #fdf2f8;
  --light-green: #ecfdf5;
  --border: #e5e7eb;
  --text: #172033;
  --muted: #5b6475;
  --white: #ffffff;
  --shadow: 0 12px 30px rgba(30, 41, 59, 0.12);
  --shadow-hover: 0 18px 40px rgba(30, 41, 59, 0.2);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(circle at 10% 10%, #fce7f3 0, transparent 25%),
    radial-gradient(circle at 90% 20%, #dbeafe 0, transparent 25%),
    linear-gradient(135deg, #fff7ed, #f8fafc 45%, #eef2ff);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

/* Header */

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  color: var(--white);
  padding: 20px max(20px, calc((100% - 1100px) / 2));
  background:
    linear-gradient(110deg, #172554, #4c1d95, #9d174d);
  box-shadow: 0 5px 20px rgba(23, 37, 84, 0.25);
}

.topbar h1,
.topbar p {
  margin: 0;
}

.topbar h1 {
  font-size: 1.8rem;
  letter-spacing: 0.5px;
}

.topbar .eyebrow {
  color: #bfdbfe;
}

